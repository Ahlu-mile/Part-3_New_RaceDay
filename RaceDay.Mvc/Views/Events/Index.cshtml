@{ViewData["Title"]="Events";JsonElement events=(JsonElement)ViewBag.Events;}<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3"><div><div class="small text-primary fw-bold text-uppercase">Race calendar</div><h1 class="section-heading">Explore events</h1></div>@if(Context.Session.GetString("Role")=="Organiser"){<a class="btn btn-primary" asp-controller="Organiser" asp-action="CreateEvent">＋ Create event</a>}</div><form class="card card-body mb-4" method="get"><div class="row g-2"><div class="col-md-4"><label class="form-label">Activity</label><select class="form-select" name="eventType"><option value="">All activities</option><option selected="@(ViewBag.EventType=="Run")">Run</option><option selected="@(ViewBag.EventType=="Walk")">Walk</option><option selected="@(ViewBag.EventType=="Cycle")">Cycle</option></select></div><div class="col-md-5"><label class="form-label">Location</label><input class="form-control" name="location" value="@ViewBag.Location" placeholder="Search by town or venue"/></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary w-100">Filter events</button></div></div></form><div class="row g-3">@if(events.ValueKind==JsonValueKind.Array){@foreach(var e in events.EnumerateArray()){<div class="col-md-6 col-xl-4"><div class="card h-100">@if(e.TryGetProperty("bannerImageUrl",out var banner) && banner.ValueKind==JsonValueKind.String && !string.IsNullOrWhiteSpace(banner.GetString())){<img src="@banner.GetString()" class="card-img-top" style="max-height:180px;object-fit:cover" alt="Event banner"/>}<div class="card-body"><span class="pill">@e.GetProperty("eventType").GetString()</span><h4 class="h5 fw-bold mt-3">@e.GetProperty("eventName").GetString()</h4><p class="text-secondary">@e.GetProperty("description").GetString()</p><p class="mb-1">📍 @e.GetProperty("location").GetString()</p><p>📅 @e.GetProperty("eventDate").ToString().Split('T')[0] · @e.GetProperty("startTime").ToString()</p><a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">Event details</a></div></div></div>}}else{<p>No event data is available. Confirm that the API is running.</p>}</div>
