@{ViewData["Title"]="Event details";JsonElement e=(JsonElement)ViewBag.Event;JsonElement cats=(JsonElement)ViewBag.Categories;JsonElement results=(JsonElement)ViewBag.Results;}@if(e.ValueKind==JsonValueKind.Object){<a asp-action="Index" class="text-decoration-none">← All events</a><div class="hero mt-3 mb-4"><span class="pill">@e.GetProperty("eventType").GetString()</span>@if(e.TryGetProperty("bannerImageUrl",out var banner) && banner.ValueKind==JsonValueKind.String && !string.IsNullOrWhiteSpace(banner.GetString())){<img src="@banner.GetString()" class="img-fluid rounded mb-3" alt="Event banner"/>}<h1 class="mt-3">@e.GetProperty("eventName").GetString()</h1><p class="lead">@e.GetProperty("description").GetString()</p><p>📍 @e.GetProperty("location").GetString() &nbsp; · &nbsp; 📅 @e.GetProperty("eventDate").ToString().Split('T')[0] &nbsp; · &nbsp; @e.GetProperty("startTime").ToString()</p><p class="mb-0">Organised by @e.GetProperty("organiserName").GetString()</p></div><h2 class="section-heading">Race categories</h2><div class="row g-3 mb-4">@if(cats.ValueKind==JsonValueKind.Array){@foreach(var c in cats.EnumerateArray()){<div class="col-md-4"><div class="card card-body h-100"><h5>@c.GetProperty("categoryName").GetString()</h5><p class="mb-1">Distance: @c.GetProperty("distanceKM").ToString() km</p><p>Entry fee: @c.GetProperty("entryFee").ToString()</p>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enter" method="post"><input type="hidden" name="categoryId" value="@c.GetProperty("categoryId").GetInt32()"/><button class="btn btn-primary">Enter event</button></form>}}</div></div>}}</div><h2 class="section-heading">Results / leaderboard</h2><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Position</th><th>Participant</th><th>Category</th><th>Finish time</th></tr></thead><tbody>@if(results.ValueKind==JsonValueKind.Array){@foreach(var r in results.EnumerateArray()){<tr><td>@(r.GetProperty("overallPosition").ValueKind==JsonValueKind.Null?"—":r.GetProperty("overallPosition").ToString())</td><td>@r.GetProperty("participantName").GetString()</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("finishTime").ToString()</td></tr>}}</tbody></table></div></div>}
