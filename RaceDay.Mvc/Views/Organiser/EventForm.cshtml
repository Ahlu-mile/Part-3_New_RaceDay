@{var edit=ViewBag.Event is JsonElement ev && ev.ValueKind==JsonValueKind.Object; ViewData["Title"]=edit?"Edit event":"Create event";var item=edit?(JsonElement)ViewBag.Event:default;}<div class="card form-card"><div class="card-body p-4 p-md-5"><h1 class="section-heading">@(edit?"Edit event":"Create an event")</h1><form method="post" enctype="multipart/form-data" asp-action="@(edit?"EditEvent":"CreateEvent")">@if(edit){<input type="hidden" name="id" value="@item.GetProperty("eventId").GetInt32()"/>}<div class="mb-3"><label class="form-label">Event name</label><input class="form-control" name="eventName" maxlength="150" value="@(edit?item.GetProperty("eventName").GetString():"")" required/></div><div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3">@(edit?item.GetProperty("description").GetString():"")</textarea></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Activity type</label><select class="form-select" name="eventType"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-6"><label class="form-label">Date</label><input class="form-control" type="date" name="eventDate" value="@(edit?item.GetProperty("eventDate").ToString().Split('T')[0]:"")" required/></div><div class="col-md-6"><label class="form-label">Location</label><input class="form-control" name="location" value="@(edit?item.GetProperty("location").GetString():"")" required/></div><div class="col-md-6"><label class="form-label">Start time</label><input class="form-control" type="time" name="startTime" value="@(edit?item.GetProperty("startTime").ToString():"08:00:00")" required/></div></div><div class="mt-3"><label class="form-label">Event banner (PNG/JPEG/WebP, max 5 MB)</label><input class="form-control" type="file" name="banner" accept="image/png,image/jpeg,image/webp"/></div><button class="btn btn-primary mt-4">Save event</button> <a class="btn btn-outline-secondary mt-4" asp-action="Index">Cancel</a></form><p class="small text-secondary mt-3">Banner uploads require Azure Storage configuration on the API and the database image-column upgrade script.</p></div></div>
