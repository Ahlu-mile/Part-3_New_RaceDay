@{ViewData["Title"]="Results";JsonElement rows=(JsonElement)ViewBag.Enrolments;JsonElement results=(JsonElement)ViewBag.Results;int eid=ViewBag.EventId;}<a asp-action="Index">← Dashboard</a><h1 class="section-heading mt-3">Capture race results</h1><div class="card card-body mb-4"><form method="post" asp-action="AddResult"><input type="hidden" name="eventId" value="@eid"/><div class="row g-2"><div class="col-md-5"><label class="form-label">Participant enrolment</label><select class="form-select" name="enrolmentId" required>@if(rows.ValueKind==JsonValueKind.Array){@foreach(var r in rows.EnumerateArray()){<option value="@r.GetProperty("enrolmentId").GetInt32()">@r.GetProperty("participantName").GetString() — @r.GetProperty("categoryName").GetString() (@r.GetProperty("status").GetString())</option>}}</select></div><div class="col-md-3"><label class="form-label">Finish time (hh:mm:ss)</label><input class="form-control" name="finishTime" type="text" pattern="[0-9]{1,2}:[0-5][0-9]:[0-5][0-9]" placeholder="01:24:30" required/></div><div class="col-md-2"><label class="form-label">Overall place</label><input class="form-control" name="overallPosition" type="number" min="1"/></div><div class="col-md-2"><label class="form-label">Category place</label><input class="form-control" name="categoryPosition" type="number" min="1"/></div></div><button class="btn btn-primary mt-3">Save result</button></form></div><h2 class="h4 section-heading">Current leaderboard</h2><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Position</th><th>Participant</th><th>Category</th><th>Time</th></tr></thead><tbody>@if(results.ValueKind==JsonValueKind.Array){@foreach(var r in results.EnumerateArray()){<tr><td>@r.GetProperty("overallPosition").ToString()</td><td>@r.GetProperty("participantName").GetString()</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("finishTime").ToString()</td></tr>}}</tbody></table></div></div>
