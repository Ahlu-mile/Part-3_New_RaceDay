@{ViewData["Title"]="Enrolments";JsonElement rows=(JsonElement)ViewBag.Enrolments;int eid=ViewBag.EventId;}<a asp-action="Index">← Dashboard</a><h1 class="section-heading mt-3">Participant enrolments</h1><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Participant</th><th>Category</th><th>Race no.</th><th>Status</th><th>Update status</th></tr></thead><tbody>@if(rows.ValueKind==JsonValueKind.Array){@foreach(var r in rows.EnumerateArray()){<tr><td>@r.GetProperty("participantName").GetString()</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("raceNumber").ToString()</td><td>@r.GetProperty("status").GetString()</td><td><form method="post" asp-action="Status" class="d-flex gap-2"><input type="hidden" name="id" value="@r.GetProperty("enrolmentId").GetInt32()"/><input type="hidden" name="eventId" value="@eid"/><select class="form-select form-select-sm" name="status"><option>Pending</option><option>Confirmed</option><option>Cancelled</option></select><button class="btn btn-primary btn-sm">Save</button></form></td></tr>}}</tbody></table></div></div>
