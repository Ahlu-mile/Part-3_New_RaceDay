@{ViewData["Title"]="Organiser dashboard";JsonElement events=(JsonElement)ViewBag.Events;}<div class="d-flex justify-content-between align-items-end mb-4"><div><div class="small text-primary fw-bold text-uppercase">Organiser workspace</div><h1 class="section-heading">Your events</h1><p class="text-secondary mb-0">Manage event details, race categories, entries and results.</p></div><a class="btn btn-primary" asp-action="CreateEvent">＋ Create event</a></div><div class="row g-3">@if(events.ValueKind==JsonValueKind.Array){@foreach(var e in events.EnumerateArray()){var id=e.GetProperty("eventId").GetInt32();<div class="col-12"><div class="card"><div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3"><div><span class="pill">@e.GetProperty("eventType").GetString()</span><h4 class="h5 mt-2 mb-1">@e.GetProperty("eventName").GetString()</h4><div class="text-secondary">@e.GetProperty("eventDate").ToString().Split('T')[0] · @e.GetProperty("location").GetString()</div></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-primary btn-sm" asp-action="EditEvent" asp-route-id="@id">Edit</a><a class="btn btn-outline-primary btn-sm" asp-action="Categories" asp-route-eventId="@id">Categories</a><a class="btn btn-outline-primary btn-sm" asp-action="Enrolments" asp-route-eventId="@id">Enrolments</a><a class="btn btn-outline-primary btn-sm" asp-action="Results" asp-route-eventId="@id">Results</a><form asp-action="DeleteEvent" method="post" onsubmit="return confirm('Delete this event?')"><input type="hidden" name="id" value="@id"/><button class="btn btn-outline-danger btn-sm">Delete</button></form></div></div></div></div>}}else{<p>No events loaded. Check API availability.</p>}</div>
