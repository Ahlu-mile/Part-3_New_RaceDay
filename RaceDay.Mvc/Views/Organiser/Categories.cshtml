@{ViewData["Title"]="Categories";JsonElement cats=(JsonElement)ViewBag.Categories;int eid=ViewBag.EventId;}<a asp-action="Index">← Dashboard</a><h1 class="section-heading mt-3">Manage categories</h1><div class="card card-body mb-4"><form method="post" asp-action="AddCategory"><input type="hidden" name="eventId" value="@eid"/><div class="row g-2"><div class="col-md-3"><label class="form-label">Category name</label><input class="form-control" name="categoryName" required/></div><div class="col-md-3"><label class="form-label">Distance (km)</label><input class="form-control" type="number" min="0.1" step="0.1" name="distanceKM" required/></div><div class="col-md-3"><label class="form-label">Maximum participants</label><input class="form-control" type="number" min="1" name="maxParticipants" value="500" required/></div><div class="col-md-3"><label class="form-label">Entry fee</label><input class="form-control" type="number" min="0" step="0.01" name="entryFee" value="0" required/></div></div><button class="btn btn-primary mt-3">Add category</button></form></div><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Distance</th><th>Capacity</th><th>Fee</th><th>Actions</th></tr></thead><tbody>@if(cats.ValueKind==JsonValueKind.Array){@foreach(var c in cats.EnumerateArray()){<tr><td colspan="4"><form method="post" asp-action="UpdateCategory" class="row g-2"><input type="hidden" name="id" value="@c.GetProperty("categoryId").GetInt32()"/><input type="hidden" name="eventId" value="@eid"/><div class="col-md-4"><input class="form-control form-control-sm" name="categoryName" value="@c.GetProperty("categoryName").GetString()" required/></div><div class="col-md-2"><input class="form-control form-control-sm" type="number" step="0.1" min="0.1" name="distanceKM" value="@c.GetProperty("distanceKM").ToString()" required/></div><div class="col-md-2"><input class="form-control form-control-sm" type="number" min="1" name="maxParticipants" value="@c.GetProperty("maxParticipants").ToString()" required/></div><div class="col-md-2"><input class="form-control form-control-sm" type="number" step="0.01" min="0" name="entryFee" value="@c.GetProperty("entryFee").ToString()" required/></div><div class="col-md-2"><button class="btn btn-sm btn-outline-primary">Update</button></div></form></td><td><form method="post" asp-action="DeleteCategory"><input type="hidden" name="id" value="@c.GetProperty("categoryId").GetInt32()"/><input type="hidden" name="eventId" value="@eid"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}}</tbody></table></div></div>
