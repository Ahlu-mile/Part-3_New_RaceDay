@{ViewData["Title"]="Home"; JsonElement events=(JsonElement)ViewBag.Events;}
<section class="hero mb-4"><div class="eyebrow mb-2">Your next finish line starts here</div><h1 class="display-5 fw-bold">Every race has a story.</h1><p class="lead col-lg-8">Discover running, walking and cycling events, manage your race entries, and celebrate every result with RaceDay.</p><a class="btn btn-light btn-lg me-2" asp-controller="Events" asp-action="Index">Explore events</a>@if(Context.Session.GetInt32("UserId")==null){<a class="btn btn-outline-light btn-lg" asp-controller="Auth" asp-action="Register">Join RaceDay</a>}</section>
<div class="d-flex justify-content-between align-items-end mb-3"><div><div class="text-uppercase small text-secondary fw-bold">Find your challenge</div><h2 class="section-heading">Upcoming events</h2></div><a asp-controller="Events" asp-action="Index">View all events →</a></div>
<div class="row g-3">@if(events.ValueKind==JsonValueKind.Array){@foreach(var e in events.EnumerateArray()){<div class="col-md-6 col-xl-4"><div class="card h-100">@if(e.TryGetProperty("bannerImageUrl",out var banner) && banner.ValueKind==JsonValueKind.String && !string.IsNullOrWhiteSpace(banner.GetString())){<img src="@banner.GetString()" class="card-img-top" style="max-height:180px;object-fit:cover" alt="Event banner"/>}<div class="card-body"><span class="pill">@e.GetProperty("eventType").GetString()</span><h5 class="mt-3 fw-bold">@e.GetProperty("eventName").GetString()</h5><p class="text-secondary">@e.GetProperty("description").GetString()</p><div>📍 @e.GetProperty("location").GetString()</div><div>📅 @e.GetProperty("eventDate").ToString().Split('T')[0]</div><a class="btn btn-primary mt-3" asp-controller="Events" asp-action="Details" asp-route-id="@e.GetProperty("eventId").GetInt32()">View event</a></div></div></div>}}</div>
