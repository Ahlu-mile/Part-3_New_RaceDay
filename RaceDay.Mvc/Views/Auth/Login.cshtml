@{ViewData["Title"]="Log in";}<div class="card form-card"><div class="card-body p-4 p-md-5"><div class="text-uppercase small text-primary fw-bold">Welcome back</div><h1 class="h2 section-heading mb-4">Log in to RaceDay</h1><form method="post"><div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control form-control-lg" type="email" id="email" name="email" autocomplete="email" required/></div><div class="mb-4"><label class="form-label" for="password">Password</label><input class="form-control form-control-lg" type="password" id="password" name="password" autocomplete="current-password" required/></div><button class="btn btn-primary btn-lg w-100">Log in</button></form><p class="mt-3 mb-0">New to RaceDay? <a asp-action="Register">Create an account</a>.</p></div></div>
