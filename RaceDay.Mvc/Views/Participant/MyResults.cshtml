@{ViewData["Title"]="My results";JsonElement rows=(JsonElement)ViewBag.Results;}<h1 class="section-heading">My race results</h1><p class="text-secondary">Your performance history and finishing positions.</p><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Category</th><th>Finish time</th><th>Overall position</th><th>Category position</th><th>Captured</th></tr></thead><tbody>@if(rows.ValueKind==JsonValueKind.Array){@foreach(var r in rows.EnumerateArray()){<tr><td>@r.GetProperty("eventName").GetString()</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("finishTime").ToString()</td><td>@r.GetProperty("overallPosition").ToString()</td><td>@r.GetProperty("categoryPosition").ToString()</td><td>@r.GetProperty("capturedAt").ToString().Split('T')[0]</td></tr>}}</tbody></table></div></div>