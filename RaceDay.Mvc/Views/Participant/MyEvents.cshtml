@{ViewData["Title"]="My events";JsonElement rows=(JsonElement)ViewBag.Events;}<h1 class="section-heading">My events</h1><p class="text-secondary">Your event entries and their current status.</p><div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Event</th><th>Category</th><th>Date entered</th><th>Race number</th><th>Status</th></tr></thead><tbody>@if(rows.ValueKind==JsonValueKind.Array){@foreach(var r in rows.EnumerateArray()){<tr><td>@r.GetProperty("eventName").GetString()</td><td>@r.GetProperty("categoryName").GetString()</td><td>@r.GetProperty("enrolmentDate").ToString().Split('T')[0]</td><td>@r.GetProperty("raceNumber").ToString()</td><td><span class="pill">@r.GetProperty("status").GetString()</span></td></tr>}}</tbody></table></div></div>