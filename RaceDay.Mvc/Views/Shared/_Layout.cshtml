<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>RaceDay | @ViewData["Title"]</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link href="~/css/site.css" rel="stylesheet"/></head><body><nav class="navbar navbar-expand-lg navbar-dark race-nav"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div id="nav" class="collapse navbar-collapse"><div class="navbar-nav me-auto"><a class="nav-link" asp-controller="Events" asp-action="Index">Events</a>@if(Context.Session.GetString("Role")=="Organiser"){<a class="nav-link" asp-controller="Organiser" asp-action="Index">Organiser dashboard</a>}@if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" asp-controller="Participant" asp-action="MyEvents">My events</a><a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a><a class="nav-link" asp-controller="Participant" asp-action="Profile">Profile</a>}</div><div class="navbar-nav align-items-lg-center">@if(Context.Session.GetInt32("UserId")!=null){<span class="navbar-text me-3">Hi, @Context.Session.GetString("FullName")</span><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Log out</button></form>}else{<a class="nav-link" asp-controller="Auth" asp-action="Login">Log in</a><a class="btn btn-light btn-sm ms-lg-2" asp-controller="Auth" asp-action="Register">Create account</a>}</div></div></div></nav><main class="container py-4"><partial name="_Alerts"/>@RenderBody()</main><footer class="footer py-4 mt-5"><div class="container">RaceDay · Run together. Go further. <span class="float-end">PROG6212 Part 3</span></div></footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts", required:false)</body></html>
